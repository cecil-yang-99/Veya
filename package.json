{
  "name": "veya",
  "version": "0.1.0",
  "private": true,
  "description": "Veya — a virtual DApp trading platform (monorepo)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @veya/shared build && pnpm --filter @veya/backend build && pnpm --filter @veya/admin build",
    "build:backend": "pnpm --filter @veya/backend build",
    "build:admin": "pnpm --filter @veya/admin build",
    "dev:backend": "pnpm --filter @veya/backend start:dev",
    "dev:admin": "pnpm --filter @veya/admin dev",
    "typecheck": "pnpm --filter @veya/backend typecheck && pnpm --filter @veya/admin typecheck",
    "migration:run": "pnpm --filter @veya/backend migration:run",
    "seed": "pnpm --filter @veya/backend seed"
  }
}
